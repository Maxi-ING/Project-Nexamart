        "isActive": true
      }
    ],
    "expressions": [
      {
        "name": "pModo",
        "kind": "m",
        "expression": "\"Snapshot\" meta [IsParameterQuery=true, List={\"Snapshot\", \"MySQL\"}, DefaultValue=\"Snapshot\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "pServidor",
