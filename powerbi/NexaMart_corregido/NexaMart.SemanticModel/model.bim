        "partitions": [
          {
            "name": "factventas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Fuente = if pModo = \"MySQL\" then MySQL.Database(pServidor, pBase, [ReturnSingleDatabase=true]){[Schema=pBase, Item=\"factventas\"]}[Data]\n             else Table.FromRows(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)), {\"order_id\", \"fecha\", \"tienda_id\", \"vendedor_id\", \"cliente_id\", \"producto_id\", \"metodo_pago_id\", \"cantidad\", \"precio_unitario\", \"precio_total\", \"es_devolucion\"}),\n    Tipos = Table.TransformColumnTypes(Fuente, {{\"order_id\", Int64.Type}, {\"fecha\", type date}, {\"tienda_id\", Int64.Type}, {\"vendedor_id\", Int64.Type}, {\"cliente_id\", Int64.Type}, {\"producto_id\", Int64.Type}, {\"metodo_pago_id\", Int64.Type}, {\"cantidad\", Int64.Type}, {\"precio_unitario\", Currency.Type}, {\"precio_total\", Currency.Type}, {\"es_devolucion\", type logical}}, \"en-US\")\nin\n    Tipos"
            }
          }
        ]
      },
      {
        "name": "DimCalendario",
        "dataCategory": "Time",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Año",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Año]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mes Número",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Mes Número]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mes Nombre",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Mes Nombre]",
            "summarizeBy": "none",
            "sortByColumn": "Mes Número"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Año-Mes",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Año-Mes]",
            "summarizeBy": "none",
            "sortByColumn": "AñoMesOrden"
          },
          {
            "type": "calculatedTableColumn",
            "name": "AñoMesOrden",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[AñoMesOrden]",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "DimCalendario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ADDCOLUMNS(CALENDAR(DATE(2025,1,1), DATE(2026,12,31)),\n    \"Año\", YEAR([Date]), \"Mes Número\", MONTH([Date]),\n    \"Mes Nombre\", FORMAT([Date], \"MMMM\"), \"Año-Mes\", FORMAT([Date], \"yyyy-MM\"),\n    \"AñoMesOrden\", YEAR([Date]) * 100 + MONTH([Date]))"
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Column",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Column]"
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Column\", BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas Brutas",
            "expression": "CALCULATE(SUM('nexamart factventas'[precio_total]), KEEPFILTERS('nexamart factventas'[es_devolucion] = FALSE()))",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Importe Devoluciones",
            "expression": "COALESCE(-CALCULATE(SUM('nexamart factventas'[precio_total]), KEEPFILTERS('nexamart factventas'[es_devolucion] = TRUE())), 0)",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Ventas Netas",
            "expression": "SUM('nexamart factventas'[precio_total])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Pedidos Venta",
            "expression": "CALCULATE(DISTINCTCOUNT('nexamart factventas'[order_id]), KEEPFILTERS('nexamart factventas'[es_devolucion] = FALSE()))",
            "formatString": "#,0",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Total Eventos",
            "expression": "DISTINCTCOUNT('nexamart factventas'[order_id])",
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "Ticket Promedio",
            "expression": "DIVIDE([Ventas Brutas], [Pedidos Venta])",
            "formatString": "#,0.00",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Unidades Vendidas",
            "expression": "CALCULATE(SUM('nexamart factventas'[cantidad]), KEEPFILTERS('nexamart factventas'[es_devolucion] = FALSE()))",
            "formatString": "#,0",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Unidades Netas",
            "expression": "SUM('nexamart factventas'[cantidad])",
            "formatString": "#,0",
            "displayFolder": "Indicadores"
          },
          {
            "name": "Total Devoluciones",
            "expression": "CALCULATE([Total Eventos], KEEPFILTERS('nexamart factventas'[es_devolucion] = TRUE()))",
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "Proporción Eventos Devolución",
            "expression": "DIVIDE([Total Devoluciones], [Total Eventos])",
            "formatString": "0.00%",
            "displayFolder": "Calidad"
          },
          {
            "name": "Ventas Mes Anterior",
            "expression": "CALCULATE([Ventas Netas], DATEADD(DimCalendario[Date], -1, MONTH))",
            "formatString": "#,0.00",
            "displayFolder": "Tiempo"
          },
          {
            "name": "% Crecimiento MoM",
            "expression": "IF(NOT ISBLANK([Ventas Netas]) && NOT ISBLANK([Ventas Mes Anterior]), DIVIDE([Ventas Netas] - [Ventas Mes Anterior], [Ventas Mes Anterior]))",
            "formatString": "0.00%",
            "displayFolder": "Tiempo"
          },
          {
            "name": "Ventas YTD",
            "expression": "IF(NOT ISBLANK([Ventas Netas]), TOTALYTD([Ventas Netas], DimCalendario[Date]))",
            "formatString": "#,0.00",
            "displayFolder": "Tiempo"
          },
          {
            "name": "Ranking Vendedor",
            "expression": "VAR IdActual = SELECTEDVALUE('nexamart dimvendedor'[vendedor_id])\nVAR Candidatos = FILTER(ALL('nexamart dimvendedor'[vendedor_id], 'nexamart dimvendedor'[nombre_vendedor]), 'nexamart dimvendedor'[vendedor_id] <> -1)\nRETURN IF(NOT ISBLANK(IdActual) && IdActual <> -1 && NOT ISBLANK([Ventas Netas]), RANKX(Candidatos, CALCULATE([Ventas Netas]), [Ventas Netas], DESC, SKIP))",
            "formatString": "0",
            "displayFolder": "Rankings"
          },
          {
            "name": "Ranking Producto en Categoría",
            "expression": "VAR CategoriaActual = SELECTEDVALUE('nexamart dimproducto'[categoria])\nVAR IdActual = SELECTEDVALUE('nexamart dimproducto'[producto_id])\nVAR ImporteActual = [Ventas Netas]\nVAR Candidatos = FILTER(ALL('nexamart dimproducto'), 'nexamart dimproducto'[categoria] = CategoriaActual)\nVAR Puesto = RANKX(Candidatos, CALCULATE([Ventas Netas]), ImporteActual, DESC, SKIP)\nVAR Desempate = COUNTROWS(FILTER(Candidatos, CALCULATE([Ventas Netas]) = ImporteActual && 'nexamart dimproducto'[producto_id] < IdActual))\nRETURN IF(NOT ISBLANK(IdActual) && NOT ISBLANK(ImporteActual), Puesto + Desempate)",
            "formatString": "0",
            "displayFolder": "Rankings"
          }
        ]
      }
    ],
